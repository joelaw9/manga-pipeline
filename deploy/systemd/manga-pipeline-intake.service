[Unit]
Description=manga-pipeline intake
After=postgresql.service remote-fs.target network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/manga-pipeline
ExecStart=/opt/manga-pipeline/.venv/bin/python -m manga_pipeline.cli intake
EnvironmentFile=/etc/manga-pipeline/pipeline.env
Environment=HOME=/root
SuccessExitStatus=3
TimeoutStartSec=4h
