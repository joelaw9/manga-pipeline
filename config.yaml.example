# manga_pipeline configuration: the schema for config.yaml (gitignored). Every key here must be in config.yaml, with the same type.

logging:
  dir: "state/logs"   # log folder; relative = project root
  level: "INFO"       # lowest level logged: DEBUG, INFO, WARNING, ERROR
  keep_days: 14       # rotated daily log files kept, per command

lock:
  enabled: true           # each command takes its own lock; false lets runs overlap
  dir: "state/locks"      # folder of the lock files (<command>.lock); relative = project root

preflight:
  min_free_mb: 500   # warn when logging.dir's drive has less free space (MiB); 0 skips the check

database:
  path: "state/pipeline.sqlite3"   # SQLite database; relative = project root; local disk, never under a share folder

paths:
  downloads: "/mnt/share/downloads"   # Suwayomi's download root, the folder holding mangas/ (on the share)
  library: "/mnt/share/library"       # root of the Kavita library the pipeline publishes into (on the share)
  staging: "/mnt/share/staging"       # finished chapters wait here (on the share, outside every library root)
  retention: "/mnt/share/retention"   # removed downloads, kept export.retention_days (share, same filesystem as downloads)
  scratch: "state/scratch"            # the chapter in hand (local disk); relative = project root
  covers: "state/covers"              # fetched cover images (local disk); relative = project root
  candidates: "state/candidates"      # open junk candidates' images (local disk); relative = project root
  naming_overrides: "rules/naming"    # per-series volume overrides, <series folder>.yaml (gitignored work folder); relative = project root
  kavita_path_map: {}                 # Kavita path prefix -> local path prefix, e.g. {"/manga": "/mnt/share"}; not empty ({} = any keys)

workflow:
  attempt_limit: 3   # failed attempts after which a chapter is needs_human

series:
  only: []   # names of the only series to work; empty = all

suwayomi:
  url: "http://localhost:4567"   # Suwayomi's base URL

kavita:
  url: "http://localhost:5000"   # Kavita's base URL
  api_key: null                  # API key of an admin user; secret: set MANGA_PIPELINE_KAVITA_API_KEY
  library_id: 1                  # the Kavita library the pipeline works; other libraries' series are out of scope
  rescan_after_minutes: 60       # a library scan is requested again when chapters are not indexed after this

export:
  retention_days: 7   # days a removed download stays in paths.retention; 0 deletes it at once

tools:   # per machine; relative = project root; nothing is searched on PATH
  avifenc: "/opt/libavif/avifenc"
  avifdec: "/opt/libavif/avifdec"
  jpegtran: "/usr/bin/jpegtran"
  oxipng: "/usr/local/bin/oxipng"
  vship: "/opt/vship/libvship.so"   # the Vship scorer library (Windows: libvship_NVIDIA.dll)

convert:
  workers: 8                   # processes encoding and decoding one chapter's pages
  min_scratch_free_mb: 2000    # process does not run with less free space (MiB) on paths.scratch's drive

sources:
  ranking: ["Weeb Central (EN)", "MangaDot (EN)", "Kagane (EN)", "Manga Ball (EN)", "Atsumaru (EN)", "MangaK (EN)"]   # re-download sources, best first (display names)
  download_timeout_hours: 24   # a queued re-download older than this is dropped for the next source

validate:
  non_chapter_names: ["Notice", "Break Notice", "Hiatus Notice", "Announcement", "Hiatus", "Author's Note"]   # dropped at discover; [] = none

junk:
  claude_token: null   # token from `claude setup-token`, handed to claude -p; secret: set MANGA_PIPELINE_JUNK_CLAUDE_TOKEN
  claude_path: "claude"   # the claude executable: a path, or a name on PATH
  review_limit: 2      # reviews listing a candidate before it is stuck (needs_human)
  review_batch: 20     # candidates junk list gives Claude per review
  ocr_device: "cpu"    # cpu | dml (DirectML, Windows) | cuda (NVIDIA, Linux)
  keywords: [repost, discord, scans, scanlat, translat, typeset, proofread, clean, redraw, read on, support us, patreon, ko-fi, paypal, gg/, join us, join our, raw provider, recruit, official domain, fastest, uploading, protected by copyright, protected under copyright, copyright law, unauthorized reproduction, unauthorized distribution, .com, .net, .org, .io]   # OCR keyword hits: case-insensitive substrings
  weak: [.com, .net, .org, .io, scans]   # keywords that count only on a unit at most 800 px tall
  paired: [clean]      # keywords that count only beside another keyword
  suppress: [linguist, all rights reserved, published under license, kidaristudio, d&c media, head of localization, localization produced by, tapas media, crisis text line, localization manager, primary qc, secondary qc]   # official credits: a text holding one has no hit
