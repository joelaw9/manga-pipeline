#!/bin/sh
# The merge gate pre-merge-commit and pre-commit run: lint, format, types (Windows and Linux), import contracts, dead code,
# then the full test suite (CLAUDE.md "Merging").
python -m ruff check . || exit 1
python -m ruff format --check . || exit 1
python -m basedpyright --warnings || exit 1
python -m basedpyright --warnings --pythonplatform Linux || exit 1
lint-imports --no-cache || exit 1
python scripts/vulture_check.py || exit 1
exec python -m pytest -q -n auto
